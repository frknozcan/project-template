{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash({{TYPECHECK_COMMAND}}:*)",
      "Bash({{TEST_COMMAND}}:*)",
      "Bash({{LINT_COMMAND}}:*)",
      "PowerShell({{TYPECHECK_COMMAND}}:*)",
