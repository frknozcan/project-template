      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git fetch:*)",
      "Bash(git init:*)",
      "Bash(git merge:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "PowerShell(git add:*)",
      "PowerShell(git am:*)",
      "PowerShell(git apply:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git config:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git init:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git mv:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git push:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git worktree:*)",
      "Edit(/.claude/**)"
